<launch>
  <!--
    Autoware as the ECU under test of autoware_carla_scenario's HILS bridge
    (scenario-hils, docs/hils.md): resident, on the HILS PC, on wall-clock time.

      scenario-hils config/hils/scenario-hils.yaml     (the bridge)
      ros2 launch autoware_carla_interface_v2 autoware_hils.launch.xml map_path:=... goal_x:=... goal_y:=... goal_yaw:=...
      uv run scenario ego.entity=hils ...              (the run, on the simulation host)

    Autoware gets only what a car would give it: the vehicle CAN
    (config/hils/carla_autoware.dbc, through hils_vehicle_interface) and the
    VLP-16's UDP packets, decoded by Autoware's own LiDAR driver (nebula).
  -->
  <arg name="map_path" description="Autoware map directory of the scenario's level"/>
  <arg name="vehicle_model" default="sample_vehicle"/>
  <arg name="sensor_model" default="awsim_sensor_kit"/>
  <arg name="data_path" default="$(env HOME)/autoware_data/ml_models"/>
  <arg name="rviz" default="false"/>
  <arg name="can_url" default="can://vcan0" description="The vehicle CAN the bridge writes (scenario-hils.yaml's vehicle_can)"/>
  <arg name="lidar_host_ip" default="127.0.0.1" description="Where the VLP-16 packets arrive"/>
  <arg name="lidar_sensor_ip" default="127.0.0.1" description="Where they come from (the bridge)"/>
  <arg name="lidar_data_port" default="2368"/>
  <arg name="goal_set" default="false" description="Set a route to goal_x/y/yaw when the ignition comes on"/>
  <arg name="goal_x" default="0.0"/>
  <arg name="goal_y" default="0.0"/>
  <arg name="goal_yaw" default="0.0"/>
  <arg name="auto_engage" default="true"/>

  <!-- The LiDAR: Autoware's own driver, on the bridge's VLP-16 packets -->
  <group>
    <push-ros-namespace namespace="/sensing/lidar/top"/>
    <node pkg="nebula_velodyne" exec="velodyne_ros_wrapper_node" name="velodyne_ros_wrapper_node" output="screen">
      <param from="$(find-pkg-share nebula_velodyne)/config/VLP16.param.yaml" allow_substs="true"/>
      <param name="host_ip" value="$(var lidar_host_ip)"/>
      <param name="sensor_ip" value="$(var lidar_sensor_ip)"/>
      <param name="data_port" value="$(var lidar_data_port)"/>
      <param name="frame_id" value="velodyne_top"/>
      <param name="launch_hw" value="true"/>
      <param name="setup_sensor" value="false"/>
      <param name="udp_only" value="true"/>
      <param name="return_mode" value="SingleStrongest"/>
      <!-- velodyne_points is PointXYZIRCAEDT, what Autoware's preprocessing reads (aw_points_ex is the older XYZIRADRT) -->
      <remap from="velodyne_points" to="pointcloud_raw_ex"/>
    </node>
  </group>

  <!-- The vehicle interface: the CAN on Autoware's side -->
  <node pkg="autoware_carla_interface_v2" exec="hils_vehicle_interface" name="hils_vehicle_interface" output="screen">
    <param name="can_url" value="$(var can_url)"/>
    <param name="goal_set" value="$(var goal_set)"/>
    <param name="goal_x" value="$(var goal_x)"/>
    <param name="goal_y" value="$(var goal_y)"/>
    <param name="goal_yaw" value="$(var goal_yaw)"/>
    <param name="auto_engage" value="$(var auto_engage)"/>
  </node>

  <!-- Autoware, without a simulator interface: the vehicle is on the CAN -->
  <include file="$(find-pkg-share autoware_launch)/launch/e2e_simulator.launch.xml">
    <arg name="map_path" value="$(var map_path)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="sensor_model" value="$(var sensor_model)"/>
    <arg name="data_path" value="$(var data_path)"/>
    <arg name="simulator_type" value="carla"/>
    <arg name="launch_simulator_interface" value="false"/>
    <arg name="use_sim_time" value="false"/>
    <arg name="rviz" value="$(var rviz)"/>
  </include>
</launch>
